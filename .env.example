# Development/demo placeholders only. Do not commit real secrets.
LOBBY_ATTENDANCE_DATABASE_PATH=data/lobby_attendance.sqlite3
# Optional local encrypted-storage smoke test only; generate a fresh 64-hex key.
# LOBBY_ATTENDANCE_STORAGE_ENCRYPTION_KEY=replace-with-a-generated-64-hex-key
# LOBBY_ATTENDANCE_STORAGE_ENCRYPTION_REQUIRED=false
LOBBY_ATTENDANCE_SITE_ID=local-site
LOBBY_ATTENDANCE_CAMERA_ID=lobby-camera
LOBBY_ATTENDANCE_TIMEZONE=UTC
# Pilot deployments must use signed sessions from an approved IdP/gateway.
LOBBY_ATTENDANCE_AUTH_MODE=signed
LOBBY_ATTENDANCE_AUTH_SIGNING_KEY=replace-with-secret-manager-reference-or-local-dev-key-at-least-32-bytes
LOBBY_ATTENDANCE_AUTH_ISSUER=approved-issuer
LOBBY_ATTENDANCE_AUTH_AUDIENCE=lobby-attendance-api
LOBBY_ATTENDANCE_AUTH_MAX_TTL_SECONDS=900
LOBBY_ATTENDANCE_AUTH_REAUTH_MAX_AGE_SECONDS=300
LOBBY_ATTENDANCE_TRUST_FORWARDED_PROTO=false
# Legacy static values below are for the supervised demo/tests only, not pilot use.
LOBBY_ATTENDANCE_ADMIN_TOKEN=replace-with-long-random-admin-token
LOBBY_ATTENDANCE_KIOSK_TOKEN=replace-with-long-random-kiosk-token
LOBBY_ATTENDANCE_ADMIN_ROLES=enrollment-administrator,attendance-administrator,auditor,system-operator,rbac-administrator
LOBBY_ATTENDANCE_QUEUE_LEASE_SECONDS=300
LOBBY_ATTENDANCE_RETENTION_DAYS=90
# Production activation remains blocked until the privacy/legal owner approves this explicitly.
LOBBY_ATTENDANCE_COMPLIANCE_APPROVED=false
# Test-only opt-in; create_app requires testing=True and mock vision as well.
LOBBY_ATTENDANCE_DEVELOPMENT_MOCK_COMPLIANCE_APPROVAL=false
LOBBY_ATTENDANCE_DEVELOPMENT_MOCK_AUTH=false
LOBBY_ATTENDANCE_DEVELOPMENT_MOCK_VISION=false
# Required when mock vision is false and the optional OpenCV package is installed.
# The path must be a regular non-symlink file; directory restriction is recommended.
# LOBBY_ATTENDANCE_VISION_MODEL_PATH=/approved/local/model/path.xml
# LOBBY_ATTENDANCE_VISION_MODEL_DIRECTORY=/approved/local
# LOBBY_ATTENDANCE_VISION_MODEL_SHA256=replace-with-reviewed-64-character-sha256
